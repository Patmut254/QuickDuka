rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────

    function isAdmin() {
      return request.auth != null && request.auth.token.email == "anitapatrick025@gmail.com";
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Checks the user's own profile document without a get() call —
    // avoids nested read costs and permission race conditions.
    // We rely on the query-level field checks (ownerUid / userId) instead
    // of hasActiveProfile() for business data, which is safer and faster.

    function isOwnerOf(doc) {
      // Owner accounts stamp ownerUid == their own uid on every record
      return request.auth.uid == doc.data.ownerUid;
    }

    function isAuthorOf(doc) {
      // Staff accounts stamp userId == their own uid on every record
      return request.auth.uid == doc.data.userId;
    }

    // ─── Users collection ───────────────────────────────────────────────────

    match /users/{userId} {
      allow read, write: if isAdmin();

      allow read: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.deleted == false
        && request.resource.data.role == "user";

      // Users may update safe profile fields only
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && !("role"                in request.resource.data.diff(resource.data).affectedKeys())
        && !("subscriptionStatus"  in request.resource.data.diff(resource.data).affectedKeys())
        && !("subscriptionPlan"    in request.resource.data.diff(resource.data).affectedKeys())
        && !("subscriptionExpiry"  in request.resource.data.diff(resource.data).affectedKeys())
        && !("deleted"             in request.resource.data.diff(resource.data).affectedKeys());

      allow delete: if false;
    }

    // ─── Blocked emails ─────────────────────────────────────────────────────

    match /blockedEmails/{emailKey} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ─── Business data ──────────────────────────────────────────────────────
    //
    // Every document in these collections has two uid fields stamped on it:
    //   ownerUid  — the business owner's uid (same as userId for owner accounts)
    //   userId    — the uid of whoever actually saved the record (owner or staff)
    //
    // Access is granted when the requester is either:
    //   • the business owner  (ownerUid == their uid), OR
    //   • the staff member who created it (userId == their uid)
    //
    // This removes the expensive get()-based hasActiveProfile() check from
    // every read, which was causing the "Missing or insufficient permissions"
    // cascade when the auth token wasn't fully propagated yet.

    function canAccessDoc(doc) {
      return isSignedIn() && (
        isAdmin() ||
        isOwnerOf(doc) ||
        isAuthorOf(doc)
      );
    }

    // For CREATE requests the document doesn't exist yet, so we check the
    // incoming resource instead.
    function canCreateDoc() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.uid == request.resource.data.ownerUid ||
        request.auth.uid == request.resource.data.userId
      );
    }

    match /purchases/{docId} {
      allow read, update, delete: if canAccessDoc(resource);
      allow create:               if canCreateDoc();
    }

    match /sales/{docId} {
      allow read, update, delete: if canAccessDoc(resource);
      allow create:               if canCreateDoc();
    }

    match /expenses/{docId} {
      allow read, update, delete: if canAccessDoc(resource);
      allow create:               if canCreateDoc();
    }

    match /losses/{docId} {
      allow read, update, delete: if canAccessDoc(resource);
      allow create:               if canCreateDoc();
    }

    match /stock/{docId} {
      allow read, update, delete: if canAccessDoc(resource);
      allow create:               if canCreateDoc();
    }

    match /credits/{docId} {
      allow read, update, delete: if canAccessDoc(resource);
      allow create:               if canCreateDoc();
    }

    match /branches/{docId} {
      allow read, update, delete: if canAccessDoc(resource);
      allow create:               if canCreateDoc();
    }

    match /staff/{docId} {
      allow read, update, delete: if canAccessDoc(resource);
      allow create:               if canCreateDoc();
    }

    match /auditLog/{docId} {
      allow read, update, delete: if canAccessDoc(resource);
      allow create:               if canCreateDoc();
    }
    
    match /aiChats/{docId} {
      allow read, update, delete: if canAccessDoc(resource);
      allow create:               if canCreateDoc();
    }

    // To-Do tasks (business task list)
    match /todos/{docId} {
      allow read, update, delete: if canAccessDoc(resource);
      allow create:               if canCreateDoc();
    }

    // ─── Referrers ──────────────────────────────────────────────────────────

    match /referrers/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /referrerApplications/{docId} {
      allow create:     if true;
      allow read, write: if isAdmin();
    }

    // ─── Page visits (write-only for signed-in users) ───────────────────────

    match /pageVisits/{docId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    // ─── Catch-all: deny everything else ────────────────────────────────────

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
