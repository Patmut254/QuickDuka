rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers

    // Admin (you) gets full unrestricted access to everything
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == "anitapatrick025@gmail.com";
    }

    // Authenticated user owns this document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Authenticated user owns this data record (sales, stock, losses, etc.)
    function ownsRecord() {
      return request.auth != null &&
             resource.data.userId == request.auth.uid;
    }

    // New record being created belongs to the authenticated user
    function creatingOwnRecord() {
      return request.auth != null &&
             request.resource.data.userId == request.auth.uid;
    }

    // Fields that ONLY the backend (Admin SDK) may write.
    // A user cannot promote their own subscription from the browser.
    function touchesSubscriptionFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasAny([
                 'subscriptionPlan',
                 'subscriptionStatus',
                 'subscriptionExpiry',
                 'subscriptionStartDate',
                 'lastPaymentAt',
                 'lastPaymentAmount',
                 'lastMpesaReceipt',
                 'trialStartedAt',
                 'createdByAdmin'
               ]);
    }


    // users/{userId}

    match /users/{userId} {
      // Admin: full access
      allow read, write: if isAdmin();

      // User: always read their own doc
      allow read: if isOwner(userId);

      // User: update their own doc — but NEVER subscription/payment fields
      // (those are written by Django backend via Admin SDK, which bypasses rules)
      allow update: if isOwner(userId) && !touchesSubscriptionFields();

      // User: create their own profile doc on first sign-up
      allow create: if isOwner(userId);

      // Deleting own account — allowed
      allow delete: if isOwner(userId);


      //  paymentHistory subcollection
      // Written exclusively by Django backend via Admin SDK (bypasses rules).
      // Users can read their own history. Nobody else.
      match /paymentHistory/{docId} {
        allow read, write: if isAdmin();
        allow read:        if isOwner(userId);
        // No user write — backend owns this
      }

      //  staff subcollection
      match /staff/{staffId} {
        allow read, write: if isAdmin();
        allow read, write: if isOwner(userId);
      }

      //  branches subcollection
      match /branches/{branchId} {
        allow read, write: if isAdmin();
        allow read, write: if isOwner(userId);
      }

      //  All other subcollections (future-proof)
      match /{subcollection}/{docId} {
        allow read, write: if isAdmin();
        allow read:        if isOwner(userId);
      }
    }


    // Business data collections
    // sales, stock, losses — each document has a userId field.
    // Users can only read and write their own records.

    match /sales/{docId} {
      allow read, write: if isAdmin();
      allow read, write: if ownsRecord();
      allow create:      if creatingOwnRecord();
    }

    match /stock/{docId} {
      allow read, write: if isAdmin();
      allow read, write: if ownsRecord();
      allow create:      if creatingOwnRecord();
    }

    match /losses/{docId} {
      allow read, write: if isAdmin();
      allow read, write: if ownsRecord();
      allow create:      if creatingOwnRecord();
    }


    // auditLog
    // Each entry has a userId field. Users append their own audit entries
    // and read their own history. Logs are immutable once written.

    match /auditLog/{docId} {
      allow read, write: if isAdmin();
      allow read:        if request.auth != null && ownsRecord();
      allow create:      if creatingOwnRecord();
      // No update/delete for users — audit logs are append-only
    }


    // pageVisits
    // Analytics. Authenticated users append their own visit records.
    // Only admin reads them.

    match /pageVisits/{docId} {
      allow read, write: if isAdmin();
      allow create:      if request.auth != null;
      // No read for regular users — internal analytics only
    }


    // contactMessages
    // Written by the Django backend (contact form → Firestore).
    // Only admin reads them. No client writes.

    match /contactMessages/{docId} {
      allow read, write: if isAdmin();
      // No client read or write — backend owns this collection
    }


    // referrerApplications
    // Public form — anyone can submit, no auth required.
    // Only admin reads and manages them.

    match /referrerApplications/{docId} {
      allow read, write: if isAdmin();
      allow create:      if true; // Public form submission
    }


    // referrers
    // Managed entirely by admin. Referrers have no direct client access.

    match /referrers/{referrerId} {
      allow read, write: if isAdmin();

      match /payments/{paymentId} {
        allow read, write: if isAdmin();
      }
    }


    // Catch-all: deny everything not listed above
    match /{document=**} {
      allow read, write: if isAdmin();
    }

  }
}
