rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin gets full access ──────────────────────────────
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == "anitapatrick025@gmail.com";
    }

    // ── users collection ────────────────────────────────────
    // Admin can read ALL user documents (needed for admin panel)
    // Each user can only read/write their own document
    match /users/{userId} {
      allow read, write: if isAdmin();
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Sub-collections (paymentHistory, etc.)
      match /{subcollection}/{docId} {
        allow read, write: if isAdmin();
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Business data collections (sales, purchases, etc.) ──
    // Users can only access their own data
    // Admin can read everything
    match /{collection}/{docId} {
      allow read, write: if isAdmin();
      allow read, write: if request.auth != null &&
                            resource.data.userId == request.auth.uid;
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;
    }
  }
}
